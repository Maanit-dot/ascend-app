{
  "name": "ascend-frontend",
  "version": "1.0.0",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "desktop": "electron ./desktop/main.js",
    "build:desktop": "electron-builder --win"
  },
  "build": {
    "appId": "com.ascend.desktop",
    "productName": "ASCEND",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASCEND",
      "artifactName": "ASCENDSetup.${ext}"
    },
    "files": [
      "desktop/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/jarvis_backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      }
    ],
    "asar": false
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "firebase": "10.14.1",
    "framer-motion": "11.11.9",
    "lucide-react": "0.454.0",
    "next": "14.2.15",
    "next-pwa": "5.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.4",
    "typescript": "5.6.3",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.15",
    "@types/node": "22.7.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
